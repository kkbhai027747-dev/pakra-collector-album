      "self_report": {{ 'p10_album.ui.self_report' | t | json }},
      "buy": {{ 'p10_album.ui.buy' | t | json }},
      "box": {{ 'p10_album.ui.box' | t | json }},
      "shop_note": {{ 'p10_album.ui.shop_note' | t | json }},
      "dialog_login_notice": {{ 'p10_album.ui.dialog_login_notice' | t | json }},
      "footer": {{ 'p10_album.ui.footer' | t | json }},
      "catalog_error": {{ 'p10_album.ui.catalog_error' | t | json }},
      "noscript": {{ 'p10_album.ui.noscript' | t | json }}
    }
  }
  </script>
</section>
{% schema %}
{
  "name": "Collector album",
  "settings": [
    {
      "type": "text",
      "id": "api_endpoint",
      "label": "Collection app endpoint",
      "default": "/apps/pakra-collection/v1/collection",
      "info": "Requires the collection service and a configured Shopify app proxy."
    }
  ],
  "presets": [{"name": "Collector album"}]
}
{% endschema %}
