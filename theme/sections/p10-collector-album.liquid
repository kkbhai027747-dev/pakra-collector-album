      "coverage": {{ 'p10_album.ui.coverage' | t | json }},
      "missing": {{ 'p10_album.ui.missing' | t | json }},
      "wishlist": {{ 'p10_album.ui.wishlist' | t | json }},
      "duplicates": {{ 'p10_album.ui.duplicates' | t | json }},
      "milestone_empty": {{ 'p10_album.ui.milestone_empty' | t | json }},
      "milestone_started": {{ 'p10_album.ui.milestone_started' | t | json }},
      "milestone_half": {{ 'p10_album.ui.milestone_half' | t | json }},
      "milestone_complete": {{ 'p10_album.ui.milestone_complete' | t | json }},
      "search": {{ 'p10_album.ui.search' | t | json }},
      "search_placeholder": {{ 'p10_album.ui.search_placeholder' | t | json }},
      "rarity": {{ 'p10_album.ui.rarity' | t | json }},
      "all_rarities": {{ 'p10_album.ui.all_rarities' | t | json }},
      "batch": {{ 'p10_album.ui.batch' | t | json }},
      "tab_all": {{ 'p10_album.ui.tab_all' | t | json }},
      "tab_owned": {{ 'p10_album.ui.tab_owned' | t | json }},
      "tab_missing": {{ 'p10_album.ui.tab_missing' | t | json }},
      "tab_wishlist": {{ 'p10_album.ui.tab_wishlist' | t | json }},
      "tab_unrecorded": {{ 'p10_album.ui.tab_unrecorded' | t | json }},
      "tab_previously_owned": {{ 'p10_album.ui.tab_previously_owned' | t | json }},
      "select_visible": {{ 'p10_album.ui.select_visible' | t | json }},
      "selection_count": {{ 'p10_album.ui.selection_count' | t | json }},
      "apply": {{ 'p10_album.ui.apply' | t | json }},
      "cancel": {{ 'p10_album.ui.cancel' | t | json }},
      "results": {{ 'p10_album.ui.results' | t | json }},
      "empty": {{ 'p10_album.ui.empty' | t | json }},
      "clear": {{ 'p10_album.ui.clear' | t | json }},
      "status_unrecorded": {{ 'p10_album.ui.status_unrecorded' | t | json }},
      "status_missing": {{ 'p10_album.ui.status_missing' | t | json }},
      "status_owned": {{ 'p10_album.ui.status_owned' | t | json }},
      "status_previously_owned": {{ 'p10_album.ui.status_previously_owned' | t | json }},
      "open_card": {{ 'p10_album.ui.open_card' | t | json }},
      "select_card": {{ 'p10_album.ui.select_card' | t | json }},
      "add_wishlist": {{ 'p10_album.ui.add_wishlist' | t | json }},
      "remove_wishlist": {{ 'p10_album.ui.remove_wishlist' | t | json }},
      "close": {{ 'p10_album.ui.close' | t | json }},
      "record": {{ 'p10_album.ui.record' | t | json }},
      "status_label": {{ 'p10_album.ui.status_label' | t | json }},
      "quantity": {{ 'p10_album.ui.quantity' | t | json }},
