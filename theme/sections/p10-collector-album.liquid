      "account_loading": {{ 'p10_album.ui.account_loading' | t | json }},
      "account_ready": {{ 'p10_album.ui.account_ready' | t | json }},
      "account_guest": {{ 'p10_album.ui.account_guest' | t | json }},
      "account_error": {{ 'p10_album.ui.account_error' | t | json }},
      "login": {{ 'p10_album.ui.login' | t | json }},
      "retry": {{ 'p10_album.ui.retry' | t | json }},
      "progress_count": {{ 'p10_album.ui.progress_count' | t | json }},
